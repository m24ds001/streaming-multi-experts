# Database
DATABASE_URL=postgresql://user:password@localhost:5432/streaming_expert
REDIS_URL=redis://localhost:6379

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Provider API Keys (get from respective platforms)
GA4_PROPERTY_ID=your_ga4_property_id
GA4_API_KEY=your_ga4_api_key
MIXPANEL_PROJECT_TOKEN=your_mixpanel_token
POSTHOG_API_KEY=your_posthog_key
CLARITY_PROJECT_ID=your_clarity_id

# Credibility Parameters (from paper Section 3.3)
ALPHA_ERROR=0.88
ALPHA_INCONSIST=0.94
DELTA_REWARD=0.012

# Cache Settings
CACHE_TTL=300
CACHE_ENABLED=true

# Rate Limiting
GA4_RATE_LIMIT=10
MIXPANEL_RATE_LIMIT=5
POSTHOG_RATE_LIMIT=100
